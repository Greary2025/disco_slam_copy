        xianfeng/camera_link:
          Value: true
        xianfeng/imu_link:
          Value: true
        xianfeng/odom:
          Value: true
        xianfeng/velodyne:
          Value: true
      Marker Alpha: 1
      Marker Scale: 1
      Name: TF
      Show Arrows: true
      Show Axes: true
      Show Names: true
      Tree:
        map:
          gensui/odom:
            gensui/base_link:
              gensui/camera_link:
                gensui/camera_color_frame:
                  gensui/camera_color_optical_frame:
                    {}
                gensui/camera_depth_frame:
                  gensui/camera_depth_optical_frame:
                    {}
              gensui/imu_link:
                {}
              gensui/velodyne:
                {}
            gensui/base_link/lidar_link:
