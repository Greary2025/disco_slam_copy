Panels:
  - Class: rviz/Displays
    Help Height: 0
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Map xianfeng1
        - /Map gensui1
        - /Path xianfeng1
        - /Path gensui1
      Splitter Ratio: 0.5
    Tree Height: 323
  - Class: rviz/Views
    Expanded:
      - /Current View1
    Name: Views
    Splitter Ratio: 0.5
Preferences:
  PromptSaveOnExit: true
Toolbars:
  toolButtonStyle: 2
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz/TF
      Enabled: true
      Filter (blacklist): ""
      Filter (whitelist): ""
      Frame Timeout: 10
      Frames:
        All Enabled: true
        gensui/base_link:
          Value: true
        gensui/base_link/lidar_link:
          Value: true
        gensui/camera_color_frame:
          Value: true
        gensui/camera_color_optical_frame:
          Value: true
        gensui/camera_depth_frame:
          Value: true
        gensui/camera_depth_optical_frame:
          Value: true
        gensui/camera_link:
          Value: true
        gensui/imu_link:
          Value: true
        gensui/odom:
          Value: true
        gensui/velodyne:
          Value: true
